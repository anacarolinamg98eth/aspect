# This test checks the tabulated Gerya water-fugacity viscosity-prefactor
# scheme in combination with the visco plastic material model. The model is
# a 50 km by 50 km box filled entirely with oceanic crust. Its temperature
# decreases linearly from 1573.15 K at the bottom to 273.15 K at the top.
#
# Fugacity is bilinearly interpolated from the temperature-pressure table
# water_fugacity_gerya_table.txt. The table must cover temperatures from
# 273.15 K to 1573.15 K and model pressures from 1e5 Pa to approximately
# 1.7e9 Pa. The oceanic-crust dislocation-creep viscosity is multiplied by
# f^(-r/n), with r/n=0.25.

set Dimension                     = 2
set End time                      = 0
set Use years instead of seconds = true
set Output directory              = output
set Pressure normalization        = surface
set Surface pressure              = 1e5
set Nonlinear solver scheme       = single Advection, iterated Stokes
set Nonlinear solver tolerance    = 1e-4
set Max nonlinear iterations      = 1

subsection Geometry model
  set Model name = box

  subsection Box
    set X extent      = 50e3
    set Y extent      = 50e3
    set X repetitions = 2
    set Y repetitions = 2
  end
end

subsection Compositional fields
  set Number of fields = 1
  set Names of fields  = ocrust
end

subsection Initial composition model
  set Model name = function

  subsection Function
    set Variable names      = x,y
    set Function expression = 1
  end
end

subsection Boundary composition model
  set Fixed composition boundary indicators = left, right, bottom, top
  set List of model names = initial composition
end

subsection Initial temperature model
  set Model name = function

  subsection Function
    set Variable names      = x,y
    set Function expression = 1573.15-1300*y/50e3
  end
end

subsection Boundary temperature model
  set Fixed temperature boundary indicators = bottom, top
  set List of model names = initial temperature
end

subsection Boundary velocity model
  set Tangential velocity boundary indicators = left, right, bottom, top
end

subsection Gravity model
  set Model name = vertical

  subsection Vertical
    set Magnitude = 9.81
  end
end

subsection Material model
  set Model name = visco plastic

  subsection Visco Plastic
    set Viscous flow law      = dislocation
    set Reference temperature = 1000
    set Thermal expansivities = 0, 0
    set Densities             = 3300, 3300
    set Heat capacities       = 1250
    set Thermal diffusivities = 1.14e-6

    set Minimum strain rate = 1e-15
    set Minimum viscosity   = 1e16
    set Maximum viscosity   = 2.5e23
    set Viscosity averaging scheme = harmonic
    set Grain size = 1

    # Disable diffusion creep.
    set Prefactors for diffusion creep           = 1e-50, 1e-50
    set Stress exponents for diffusion creep     = 1, 1
    set Grain size exponents for diffusion creep = 0, 0
    set Activation energies for diffusion creep  = 0, 0
    set Activation volumes for diffusion creep   = 0, 0

    # The first entry is the background material; the second is a wet-quartz
    # flow law assigned to the ocrust field.
    set Prefactors for dislocation creep          = 2.93e-17, 1.363990010960491e-41
    set Stress exponents for dislocation creep    = 3.5, 4
    set Activation energies for dislocation creep = 540e3, 125e3
    set Activation volumes for dislocation creep  = 12e-6, 0

    set Viscosity prefactor scheme = water_fugacity_gerya
    set Water fugacity exponents for dislocation creep = 0, 0.25

    set Fugacity table data directory = @SOURCE_DIR@/
    set Fugacity table file name      = water_fugacity_gerya_table.txt
  end
end

subsection Mesh refinement
  set Initial global refinement   = 0
  set Initial adaptive refinement = 0
end

subsection Postprocess
  set List of postprocessors = material statistics, visualization

  subsection Visualization
    set Interpolate output           = false
    set List of output variables     = named additional outputs, material properties
    set Output format                = gnuplot
    set Time between graphical output = 0

    subsection Material properties
      set List of material properties = viscosity
    end
  end
end

subsection Solver parameters
  subsection Stokes solver parameters
    set Number of cheap Stokes solver steps = 40
    set Linear solver tolerance = 1e-6
  end
end
